<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#087f4e">
<title>🌿 App Guide</title>
<style>
:root {
  --bg-color: #eef8f2;
  --text-color: #123d2b;
  --card-bg: #ffffff;
  --header-bg: linear-gradient(135deg,#075a38,#16a866);
  --desc-color: #71867b;
  --label-bg: #dff4e8;
  --banner-bg: #fff3cd;
  --banner-text: #856404;
}

[data-theme="dark"] {
  --bg-color: #121815;
  --text-color: #e0ece5;
  --card-bg: #1c2420;
  --header-bg: linear-gradient(135deg,#053823,#0e6b41);
  --desc-color: #9cb0a5;
  --label-bg: #193829;
  --banner-bg: #2c2512;
  --banner-text: #ffe08a;
}

*{box-sizing:border-box}
body{margin:0;font-family:Arial,Tahoma,sans-serif;background:var(--bg-color);color:var(--text-color);transition:0.3s}
header{background:var(--header-bg);color:#fff;padding:25px 20px 35px;border-radius:0 0 32px 32px}
.logo-container{display:flex;justify-content:space-between;align-items:center;max-width:900px;margin:auto;flex-wrap:wrap;gap:10px}
.logo{font-size:28px;font-weight:800}.sub{margin-top:6px;color:#d9f8e8}
.controls{display:flex;gap:8px;align-items:center}
.theme-toggle, .lang-select{background:rgba(255,255,255,0.2);border:0;color:#fff;padding:8px 12px;border-radius:20px;cursor:pointer;font-size:14px}
.lang-select option{background:#075a38;color:#fff}
.dev-banner{background:var(--banner-bg);color:var(--banner-text);border:1px solid rgba(0,0,0,0.1);padding:12px;border-radius:12px;margin-bottom:18px;font-size:13px;text-align:center;font-weight:bold}
main{max-width:900px;margin:auto;padding:20px}h2{font-size:21px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.category{background:var(--card-bg);border:0;border-radius:18px;padding:18px;text-align:initial;box-shadow:0 4px 15px #0001;cursor:pointer;color:var(--text-color);width:100%}
.icon{font-size:30px}.title{font-weight:bold;font-size:16px;margin-top:8px}.desc{font-size:12px;color:var(--desc-color);margin-top:6px}
.hidden{display:none}.back{border:0;background:#087f4e;color:#fff;border-radius:12px;padding:10px 16px;font-size:15px;cursor:pointer;margin-bottom:15px}
.columns{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.label{text-align:center;font-weight:bold;background:var(--label-bg);padding:11px;border-radius:13px;margin-bottom:10px;color:var(--text-color)}
.card{background:var(--card-bg);border-radius:15px;padding:14px;margin-bottom:10px;box-shadow:0 3px 12px #0001;color:var(--text-color)}
.app{font-weight:bold;font-size:16px}.desc{line-height:1.6}
.visit{display:block;text-align:center;text-decoration:none;background:#087f4e;color:white;border-radius:10px;padding:9px;font-size:13px;margin-top:10px}
.note{background:var(--card-bg);border-radius:14px;padding:12px;font-size:12px;color:var(--desc-color);margin-bottom:15px}
footer{text-align:center;color:var(--desc-color);font-size:12px;padding:25px}
@media(max-width:650px){.columns,.grid{grid-template-columns:1fr}.category{padding:15px}}
</style>
</head>
<body>
<header>
<div class="logo-container">
  <div>
    <div class="logo">🌿 App Guide</div>
    <div class="sub" id="subTitle">دليلك للتطبيقات حسب نظام التشغيل والخصائص</div>
  </div>
  <div class="controls">
    <select id="langSelect" class="lang-select">
      <option value="ar">العربية 🇸🇦</option>
      <option value="en">English 🇬🇧</option>
      <option value="fr">Français 🇫🇷</option>
    </select>
    <button id="themeBtn" class="theme-toggle">🌙</button>
  </div>
</div>
</header>
<main>
<div class="dev-banner" id="devBanner">⚠️ تنبيه: هذه المنصة ما زالت نسخة تجريبية قيد التطوير والتحسين المستمر.</div>

<!-- الصفحة الأولى: اختيار النظام -->
<section id="osPage">
<h2 id="selectOsTitle">اختر نظام التشغيل</h2>
<div id="osList" class="grid"></div>
</section>

<!-- الصفحة الثانية: اختيار المجال/الخانة -->
<section id="fieldsPage" class="hidden">
<button id="backToOs" class="back">‹ العودة للأنظمة</button>
<h2 id="osTitle"></h2>
<div id="fieldsList" class="grid"></div>
</section>

<!-- الصفحة الثالثة: قائمة التطبيقات المجانية والمدفوعة -->
<section id="appsPage" class="hidden">
<button id="backToFields" class="back">‹ العودة للمجالات</button>
<h2 id="fieldTitle"></h2>
<div class="note" id="noteText">🔗 الروابط توجه إلى المواقع الرسمية للتطبيقات.</div>
<div class="columns">
  <div><div class="label" id="freeLabel">🆓 10 تطبيقات مجانية</div><div id="freeList"></div></div>
  <div><div class="label" id="paidLabel">💎 10 تطبيقات مدفوعة / اشتراك</div><div id="paidList"></div></div>
</div>
</section>

<footer id="footerText">App Guide — نسخة تجريبية قيد التطوير</footer>
</main>

