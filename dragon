function updateLanguageUI() {
  const t = uiTexts[currentLang];
  document.getElementById("subTitle").innerText = t.sub;
  document.getElementById("devBanner").innerText = t.banner;
  document.getElementById("selectOsTitle").innerText = t.selectOs;
  document.getElementById("backToOs").innerText = t.backToOs;
  document.getElementById("backToFields").innerText = t.backToFields;
  document.getElementById("noteText").innerText = t.note;
  document.getElementById("freeLabel").innerText = t.freeLabel;
  document.getElementById("paidLabel").innerText = t.paidLabel;
  document.getElementById("footerText").innerText = t.footer;
  
  // ضبط اتجاه الصفحة حسب اللغة
  if (currentLang === "ar") {
    document.documentElement.dir = "rtl";
    document.documentElement.lang = "ar";
  } else {
    document.documentElement.dir = "ltr";
    document.documentElement.lang = currentLang;
  }

  renderOsList();
  if (selectedOs) renderFieldsList();
  if (selectedField) loadAppsData();
}

function renderOsList() {
  const t = uiTexts[currentLang];
  const list = systemsData[currentLang];
  const osList = document.getElementById("osList");
  osList.innerHTML = list.map(s => `
    <button class="category" onclick="selectOs('${s.id}', '${s.title}')">
      <div class="icon">${s.icon}</div>
      <div class="title">${s.title}</div>
      <div class="desc">${t.osDesc}</div>
    </button>
  `).join("");
}

function selectOs(id, title) {
  selectedOs = id;
  document.getElementById("osTitle").innerText = title;
  document.getElementById("osPage").classList.add("hidden");
  document.getElementById("fieldsPage").classList.remove("hidden");
  renderFieldsList();
}

function renderFieldsList() {
  const t = uiTexts[currentLang];
  const list = fieldsData[currentLang];
  const fieldsList = document.getElementById("fieldsList");
  fieldsList.innerHTML = list.map(f => `
    <button class="category" onclick="selectField('${f.id}', '${f.title}')">
      <div class="icon">${f.icon}</div>
      <div class="title">${f.title}</div>
      <div class="desc">${t.fieldDesc}</div>
    </button>
  `).join("");
}

function selectField(fieldId, fieldTitle) {
  selectedField = fieldId;
  document.getElementById("fieldTitle").innerText = fieldTitle;
  document.getElementById("fieldsPage").classList.add("hidden");
  document.getElementById("appsPage").classList.remove("hidden");
  loadAppsData();
}

function loadAppsData() {
  const data = sampleApps[selectedField] || sampleApps.thumbnails;
  renderList("freeList", data.free);
  renderList("paidList", data.paid);
}

function renderList(elementId, items) {
  const t = uiTexts[currentLang];
  const container = document.getElementById(elementId);
  container.innerHTML = items.map(item => `
    <div class="card">
      <div class="app">${item[0]}</div>
      <div class="desc">${item[1]}</div>
      <a href="${item[2]}" target="_blank" class="visit">${t.visit}</a>
    </div>
  `).join("");
}

// أزرار العودة
document.getElementById("backToOs").onclick = () => {
  document.getElementById("fieldsPage").classList.add("hidden");
  document.getElementById("osPage").classList.remove("hidden");
  selectedOs = null;
};

document.getElementById("backToFields").onclick = () => {
  document.getElementById("appsPage").classList.add("hidden");
  document.getElementById("fieldsPage").classList.remove("hidden");
  selectedField = null;
};

// تغيير اللغة
document.getElementById("langSelect").onchange = (e) => {
  currentLang = e.target.value;
  updateLanguageUI();
};

// الثيم الداكن
document.getElementById("themeBtn").onclick = () => {
  const isDark = document.body.getAttribute("data-theme") === "dark";
  document.body.setAttribute("data-theme", isDark ? "light" : "dark");
};

// التشغيل المبدئي
